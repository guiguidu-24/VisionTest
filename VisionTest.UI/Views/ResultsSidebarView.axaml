<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:VisionTest.UI.ViewModels"
             x:Class="VisionTest.UI.Views.ResultsSidebarView"
			 x:DataType="vm:MainViewModel">

	<Grid RowDefinitions="Auto, Auto, *">
		<Border Padding="15" Grid.Row="0">
			<StackPanel  Spacing="10">
				<Button Command="{Binding ImportImageCommand}"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Center"
						Content="Import Image"
						Classes="accent"/>
					

				<Button Command="{Binding RunOcrCommand}"
						IsEnabled="{Binding IsImageLoaded}"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Center"
						Content="Run Analysis"
						Classes="success" />
			</StackPanel>
		</Border>

		<Separator Grid.Row="1" Margin="0" />

		<Border Padding="10" Grid.Row="2">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top"
						   Text="DETECTION RESULTS"
						   FontWeight="Bold"
						   FontSize="12"
						   Foreground="Gray"
						   Margin="5,0,0,10"/>

				<ListBox ItemsSource="{Binding DetectedElements}"
						 SelectedItem="{Binding SelectedElement}"
						 Background="Transparent"
						 BorderThickness="0">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Padding="8"
									BorderBrush="#33000000"
									BorderThickness="0,0,0,1"
									CornerRadius="4">
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding Text}"
											   FontWeight="SemiBold"
											   TextWrapping="Wrap"/>

									<StackPanel Orientation="Horizontal" Spacing="10">
										<TextBlock Text="{Binding BoundsDisplay}"
												   FontSize="10"
												   Foreground="Gray"/>
										<TextBlock Text="{Binding ConfidenceDisplay}"
												   FontSize="10"
												   Foreground="DodgerBlue"
												   FontWeight="Bold"/>
									</StackPanel>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
